# Copy to .env.local and edit. All variables are optional.

# Which storage backend to use: local | memory
# "memory" disables persistence between reloads, which is useful when
# debugging first-run behaviour. Tests always use memory regardless.
VITE_PERSISTENCE_DRIVER=local

# Accounts (optional). Set both, or neither.
# Sign in with Google, and your history and your own texts follow you between
# browsers. Without them everything is kept in this browser and nothing is sent
# anywhere. Both values are public: what the anon key may touch is decided by
# row-level security in the database. See docs/SUPABASE.md for the setup.
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-publishable-anon-key
