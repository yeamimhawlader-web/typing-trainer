# Copy to .env.local and edit. All variables are optional.

# Which storage backend to use: local | memory
# "memory" disables persistence between reloads, which is useful when
# debugging first-run behaviour. Tests always use memory regardless.
VITE_PERSISTENCE_DRIVER=local

# Accounts (optional). Set both, or neither.
# Signed in, a typist's history, their own texts, their Golden Nuggets and their
# settings follow them between browsers. Without these everything is kept in
# this browser and nothing is sent anywhere. Both values are public: what the anon key may touch is decided by
# row-level security in the database. See docs/SUPABASE.md for the setup.
# The key goes under either name; use whichever your dashboard shows.
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# VITE_SUPABASE_ANON_KEY=the-older-anon-key-if-that-is-what-you-have

# Whether this project has a Google client registered (true | 1 | on | yes).
# Off unless it plainly says otherwise, and the "Continue with Google" button
# is drawn only where it is on. Registering the client is a separate job from
# making the project -- a Google Cloud project, an OAuth client, and the two
# dashboards agreeing with each other -- and a project without one answers
# anyone who presses the button with "provider is not enabled". A dead end on
# the one page that leads to an account is a worse offer than no button, so
# this says when the button will work. See docs/SUPABASE.md, "Google sign-in".
# VITE_SUPABASE_GOOGLE=true
